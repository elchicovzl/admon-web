# Database - Supabase Connection Pooling (REQUIRED for Vercel/serverless)
# Use Transaction Pooling URL from Supabase Dashboard → Settings → Database → Connection Pooling
# IMPORTANT: Add query parameters for serverless optimization:
#   - ?pgbouncer=true → Disables prepared statements (CRITICAL for Transaction Pooling)
#   - &connection_limit=1 → Limits connections per serverless function (RECOMMENDED)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.ivmprrbjnhtasciimafe:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct URL (for migrations only, uses IPv6)
# Get from Supabase Dashboard → Settings → Database → Direct Connection
# This URL is used ONLY for running migrations (prisma migrate)
# Runtime queries will use DATABASE_URL (pooling) instead
DIRECT_URL="postgresql://postgres.ivmprrbjnhtasciimafe:[YOUR-PASSWORD]@db.ivmprrbjnhtasciimafe.supabase.co:5432/postgres"

# NextAuth v5 (Auth.js)
# Generate a random secret: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000"

# AWS S3 Configuration (for client document uploads)
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-bucket-name"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Credentials Encryption (for administrator portal credentials)
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="your-encryption-key-here"

# Environment
NODE_ENV="development"

# Email Configuration (Gmail + Nodemailer)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"
CONTACT_EMAIL="where-to-receive@gmail.com"


R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key
R2_SECRET_ACCESS_KEY=tu_secret_key
R2_BUCKET_NAME=my-app-files
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev # opcional, si configuras dominio público


RESEND_API_KEY=re_KJLubc4p_8uYXekaTdU9FFoGBHGQKAM9N
RESEND_FROM_EMAIL="Administración Segura Web <no-reply@administracionsegura.co>"

# Alegra API (credenciales del service user dedicado para la integración de finanzas)
# Ver docs/runbooks/alegra-credentials.md para cómo generarlas y rotarlas.
