// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum for user roles
enum UserRole {
  SUPER_ADMIN
  MANAGER
}

// Main User model
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  role          UserRole  @default(MANAGER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Self-relation: who created this user
  createdById   String?
  createdBy     User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[]    @relation("UserCreatedBy")

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // Client relations
  createdClients      Client[]           @relation("ClientCreatedBy")
  clientNotes         ClientNote[]       @relation("NoteCreatedBy")
  uploadedDocuments   ClientDocument[]   @relation("DocumentUploadedBy")
  createdCredentials  ClientCredential[] @relation("CredentialCreatedBy")

  @@map("users")
}

// NextAuth Account model (for OAuth providers)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Client Management Enums
enum IdentificationType {
  CEDULA
  CEDULA_EXTRANJERIA
  PPT
  NIT
}

enum ClientType {
  EMPLEADO
  EMPRESA
  INDEPENDIENTE
}

// Client model
model Client {
  id                   String             @id @default(cuid())
  fullName             String
  identificationType   IdentificationType
  identificationNumber String             @unique
  clientType           ClientType
  email                String
  phone                String
  status               String             @default("ACTIVO")
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  createdById String
  createdBy   User               @relation("ClientCreatedBy", fields: [createdById], references: [id])
  notes       ClientNote[]
  documents   ClientDocument[]
  credentials ClientCredential[]

  @@map("clients")
}

// Client Note model
model ClientNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById String
  createdBy User     @relation("NoteCreatedBy", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_notes")
}

// Client Document model
model ClientDocument {
  id           String   @id @default(cuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  s3Key        String
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@map("client_documents")
}

// Administrator type enum
enum AdministratorType {
  EPS
  AFP
  ARL
  CCF
  PILA_OPERATOR
  OTRA
}

// Client Credential model (for managing administrator portal credentials)
model ClientCredential {
  id                String             @id @default(cuid())
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Administrator information
  administratorName String             // e.g., "Sura EPS", "Porvenir AFP"
  administratorType AdministratorType

  // Credentials (username in plain text, password encrypted with AES-256-GCM)
  username          String
  encryptedPassword String             @db.Text

  // Optional metadata
  portalUrl         String?
  notes             String?            @db.Text

  // Audit trail
  createdById       String
  createdBy         User               @relation("CredentialCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("client_credentials")
  @@index([clientId])
}
