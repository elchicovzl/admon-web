// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum for user roles
enum UserRole {
  SUPER_ADMIN
  MANAGER
}

// Main User model
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(MANAGER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Self-relation: who created this user
  createdById   String?
  createdBy     User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[]    @relation("UserCreatedBy")

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // Client relations
  createdClients      Client[]           @relation("ClientCreatedBy")
  clientNotes         ClientNote[]       @relation("NoteCreatedBy")
  uploadedDocuments   ClientDocument[]   @relation("DocumentUploadedBy")
  createdCredentials  ClientCredential[] @relation("CredentialCreatedBy")

  // Disability relations
  createdDisabilities       Disability[]            @relation("DisabilityCreatedBy")
  disabilityObservations    DisabilityObservation[] @relation("DisabilityObservationCreatedBy")

  // Affiliation relations
  createdAffiliations            Affiliation[]            @relation("AffiliationCreatedBy")
  sentAffiliations               Affiliation[]            @relation("AffiliationSentBy")
  assignedSubProcesses           AffiliationSubProcess[]  @relation("SubProcessAssignedTo")
  uploadedAffiliationDocuments   AffiliationDocument[]    @relation("AffiliationDocumentUploadedBy")
  affiliationObservations        AffiliationObservation[] @relation("AffiliationObservationCreatedBy")
  affiliationStatusLogs          AffiliationStatusLog[]   @relation("StatusLogChangedBy")

  @@map("users")
}

// NextAuth Account model (for OAuth providers)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// OTP Rate Limiting model
model OtpRateLimit {
  id           String    @id @default(cuid())
  email        String
  attempts     Int       @default(1)
  lastAttempt  DateTime  @default(now())
  blockedUntil DateTime?

  @@map("otp_rate_limits")
  @@index([email])
}

// Client Management Enums
enum IdentificationType {
  // Personas Naturales
  CEDULA                // CC  - Cédula de Ciudadanía
  TARJETA_IDENTIDAD     // TI  - Tarjeta de Identidad
  REGISTRO_CIVIL        // RC  - Registro Civil
  CEDULA_EXTRANJERIA    // CE  - Cédula de Extranjería
  PASAPORTE             // PA  - Pasaporte
  PPT                   //      Permiso de Protección Temporal
  PEP                   //      Permiso Especial de Permanencia
  NUIP                  //      Número Único de Identificación Personal
  // Personas Jurídicas
  NIT                   //      Número de Identificación Tributaria
}

enum ClientType {
  EMPLEADO
  EMPRESA
  INDEPENDIENTE
}

enum DocumentCategory {
  GENERAL
  ARL
  EPS
  AFP
  OTROS
}

// Client model
model Client {
  id                   String             @id @default(cuid())
  fullName             String
  identificationType   IdentificationType
  identificationNumber String             @unique
  clientType           ClientType
  email                String
  phone                String
  status               String             @default("ACTIVO")
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  createdById String
  createdBy   User               @relation("ClientCreatedBy", fields: [createdById], references: [id])
  notes       ClientNote[]
  documents   ClientDocument[]
  credentials ClientCredential[]

  // Company-Employee relationship (self-referential)
  companyId String?
  company   Client?  @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: SetNull)
  employees Client[] @relation("CompanyEmployees")

  // Disability relations (both as client and employee)
  disabilitiesAsClient   Disability[] @relation("DisabilityClient")
  disabilitiesAsEmployee Disability[] @relation("DisabilityEmployee")

  // Affiliation relations
  affiliations Affiliation[]
  subProcessesAsEmployee AffiliationSubProcess[] @relation("SubProcessEmployee")

  // Address and additional info
  address             ClientAddress?
  additionalInfo      ClientAdditionalInfo?
  beneficiaries       ClientBeneficiary[]
  legalRepresentative LegalRepresentative?

  @@map("clients")
  @@index([companyId])
}

// Client Note model
model ClientNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById String
  createdBy User     @relation("NoteCreatedBy", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_notes")
}

// Client Document model
model ClientDocument {
  id           String           @id @default(cuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  s3Key        String
  category     DocumentCategory @default(GENERAL)
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())

  @@map("client_documents")
  @@index([clientId, category])
}

// Administrator type enum
enum AdministratorType {
  EPS
  AFP
  ARL
  CCF
  PILA_OPERATOR
  OTRA
}

// Client Credential model (for managing administrator portal credentials)
model ClientCredential {
  id                String             @id @default(cuid())
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Administrator information
  administratorName String             // e.g., "Sura EPS", "Porvenir AFP"
  administratorType AdministratorType

  // Credentials (username in plain text, password encrypted with AES-256-GCM)
  username          String
  encryptedPassword String             @db.Text

  // Optional metadata
  portalUrl         String?
  notes             String?            @db.Text

  // Audit trail
  createdById       String
  createdBy         User               @relation("CredentialCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("client_credentials")
  @@index([clientId])
}

// Disability Management Enums
enum DisabilityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CLOSED
  URGENT
}

enum HealthAdministrator {
  EPS_SURA
  PORVENIR
  NUEVA_EPS
  ARL_SURA
  SALUD_TOTAL
  SAVIA_SALUD
}

// Disability model (Incapacidades)
model Disability {
  id               String              @id @default(cuid())
  receptionDate    DateTime            // Fecha de recepción
  status           DisabilityStatus

  // Client and Employee relations
  clientId         String
  client           Client              @relation("DisabilityClient", fields: [clientId], references: [id])
  employeeId       String
  employee         Client              @relation("DisabilityEmployee", fields: [employeeId], references: [id])

  // Administrator
  administrator    HealthAdministrator

  // Dates
  startDate        DateTime            // Fecha inicio incapacidad
  endDate          DateTime            // Fecha finalización

  // Additional fields
  bankRegistry     Boolean             @default(false) // Registro banco
  transcription    String              @db.Text        // Transcripción
  filing           String              @db.Text        // Radicación

  // Proof file (comprobante)
  proofFileUrl     String?
  proofS3Key       String?

  // Soft delete
  isActive         Boolean             @default(true)

  // Timestamps
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Audit trail
  createdById      String
  createdBy        User                @relation("DisabilityCreatedBy", fields: [createdById], references: [id])

  // Relations
  observations     DisabilityObservation[]

  @@map("disabilities")
  @@index([clientId])
  @@index([employeeId])
  @@index([status])
}

// Disability Observation model
model DisabilityObservation {
  id           String     @id @default(cuid())
  content      String     @db.Text
  disabilityId String
  disability   Disability @relation(fields: [disabilityId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User       @relation("DisabilityObservationCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("disability_observations")
  @@index([disabilityId])
}

// Client Address model
model ClientAddress {
  id           String   @id @default(cuid())
  clientId     String   @unique
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Geographic information
  departamento String
  municipio    String
  ciudad       String?
  direccion    String   @db.Text

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("client_addresses")
}

// Client Additional Info model
model ClientAdditionalInfo {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Employment information
  actividadComercial String?
  salario            Decimal? @db.Decimal(12, 2)

  // Entry/exit dates
  fechaIngreso       DateTime?
  fechaRetiro        DateTime?

  // Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("client_additional_info")
}

// Client Beneficiary model
model ClientBeneficiary {
  id                   String             @id @default(cuid())
  clientId             String
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Beneficiary information
  tipoRelacion         String             // "hijo", "padre", "conyuge", "otro"
  nombreCompleto       String
  identificationType   IdentificationType
  identificationNumber String

  // Timestamps
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("client_beneficiaries")
  @@index([clientId])
  @@unique([clientId, identificationNumber])
}

// Legal Representative model (for companies)
model LegalRepresentative {
  id                   String             @id @default(cuid())
  clientId             String             @unique
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Representative information
  fullName             String
  identificationType   IdentificationType
  identificationNumber String
  email                String?
  phone                String?

  // Timestamps
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("legal_representatives")
}

// ========================================
// AFFILIATION MODULE (Afiliaciones a Seguridad Social)
// ========================================

// Affiliation lifecycle status
enum AffiliationStatus {
  ACTIVE   // In progress (default)
  SENT     // Sent to client
  ARCHIVED // Archived (permanent)
}

// Sub-process types
enum AffiliationSubProcessType {
  ARL              // Administradora de Riesgos Laborales
  EPS              // Entidad Promotora de Salud
  AFP              // Administradora de Fondos de Pensiones
  CCF              // Caja de Compensación Familiar
  PILA             // Pila
  TRASLADOS        // Traslados
  INCAPACIDADES    // Incapacidades
  CONCILIACION_MORA // Conciliación Mora
}

// Sub-process status states
enum AffiliationSubProcessStatus {
  NOT_STARTED      // Sin iniciar
  IN_PROGRESS      // En proceso
  PENDING_SUPPORT  // Pendiente de soporte
  IN_REVIEW        // En revisión
  COMPLETED        // Terminado
  RETURNED         // Devuelto/Rechazado
}

// Document categories for affiliation documents
enum AffiliationDocumentCategory {
  ARL_DOCS
  EPS_DOCS
  AFP_DOCS
  CCF_DOCS
  PILA_DOCS
  TRASLADOS_DOCS
  INCAPACIDADES_DOCS
  CONCILIACION_MORA_DOCS
  GENERAL
}

// Main Affiliation model
model Affiliation {
  id                String                  @id @default(cuid())
  affiliationNumber String                  @unique
  clientId          String
  client            Client                  @relation(fields: [clientId], references: [id])

  // Status tracking
  status           AffiliationStatus       @default(ACTIVE)
  sentAt           DateTime?               // When sent to client
  sentById         String?                 // Manager who sent
  sentBy           User?                   @relation("AffiliationSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  archivedAt       DateTime?               // When archived

  // Audit trail
  createdById      String
  createdBy        User                    @relation("AffiliationCreatedBy", fields: [createdById], references: [id])

  // Soft delete (kept for compatibility)
  isActive         Boolean                 @default(true)

  // Timestamps
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relations
  subProcesses     AffiliationSubProcess[]

  @@map("affiliations")
  @@index([status])
  @@index([clientId])
  @@index([createdById])
}

// Sub-process model (ARL, EPS, AFP, CCF)
model AffiliationSubProcess {
  id                String                        @id @default(cuid())
  affiliationId     String
  affiliation       Affiliation                   @relation(fields: [affiliationId], references: [id], onDelete: Cascade)

  // Sub-process configuration
  type              AffiliationSubProcessType
  status            AffiliationSubProcessStatus   @default(NOT_STARTED)

  // Manager assignment (nullable - can be unassigned)
  assignedToId      String?
  assignedTo        User?                         @relation("SubProcessAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Status change reason (for RETURNED status)
  statusReason      String?                       @db.Text

  // Employee assignment (for EMPRESA clients - which employee this sub-process belongs to)
  employeeId        String?
  employee          Client?                       @relation("SubProcessEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  // Timestamps
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  // Relations
  documents         AffiliationDocument[]
  observations      AffiliationObservation[]
  statusLogs        AffiliationStatusLog[]

  @@map("affiliation_subprocesses")
  @@index([affiliationId])
  @@index([assignedToId])
  @@index([status])
  @@index([type])
  @@index([employeeId])
}

// Document model for sub-process documents
model AffiliationDocument {
  id             String                        @id @default(cuid())
  subProcessId   String
  subProcess     AffiliationSubProcess         @relation(fields: [subProcessId], references: [id], onDelete: Cascade)

  // File metadata
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int
  s3Key          String
  category       AffiliationDocumentCategory   @default(GENERAL)

  // Audit trail
  uploadedById   String
  uploadedBy     User                          @relation("AffiliationDocumentUploadedBy", fields: [uploadedById], references: [id])

  // Timestamps
  createdAt      DateTime                      @default(now())

  @@map("affiliation_documents")
  @@index([subProcessId])
  @@index([category])
}

// Observation/Note model for sub-processes
model AffiliationObservation {
  id            String                  @id @default(cuid())
  content       String                  @db.Text
  subProcessId  String
  subProcess    AffiliationSubProcess   @relation(fields: [subProcessId], references: [id], onDelete: Cascade)

  // Audit trail
  createdById   String
  createdBy     User                    @relation("AffiliationObservationCreatedBy", fields: [createdById], references: [id])

  // Timestamps
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("affiliation_observations")
  @@index([subProcessId])
}

// Status change log for audit trail
model AffiliationStatusLog {
  id                String                        @id @default(cuid())
  subProcessId      String
  subProcess        AffiliationSubProcess         @relation(fields: [subProcessId], references: [id], onDelete: Cascade)

  // Status change details
  fromStatus        AffiliationSubProcessStatus?  // Null for initial status
  toStatus          AffiliationSubProcessStatus
  reason            String?                       @db.Text

  // Audit trail
  changedById       String
  changedBy         User                          @relation("StatusLogChangedBy", fields: [changedById], references: [id])

  // Timestamp
  createdAt         DateTime                      @default(now())

  @@map("affiliation_status_logs")
  @@index([subProcessId])
  @@index([createdAt])
}
