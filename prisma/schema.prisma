// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum for user roles
enum UserRole {
  SUPER_ADMIN
  MANAGER
}

// Main User model
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(MANAGER)
  isActive      Boolean   @default(true)

  // Acceso al módulo Control (caja interna: movimientos, préstamos, cierres).
  // Es un permiso ORTOGONAL al rol, no un rol nuevo: `role` es un campo único,
  // así que un UserRole.CONTROL le quitaría al usuario todo lo demás (clientes,
  // procesos, incapacidades). Con este flag un MANAGER puede llevar la caja sin
  // perder el resto del dashboard.
  //
  // SUPER_ADMIN entra siempre, tenga el flag en false o no — ver lib/auth/rbac.ts.
  canAccessControl Boolean @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Self-relation: who created this user
  createdById   String?
  createdBy     User?     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[]    @relation("UserCreatedBy")

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // Client relations
  createdClients      Client[]           @relation("ClientCreatedBy")
  clientNotes         ClientNote[]       @relation("NoteCreatedBy")
  uploadedDocuments   ClientDocument[]   @relation("DocumentUploadedBy")
  createdCredentials  ClientCredential[] @relation("CredentialCreatedBy")

  // Disability relations
  createdDisabilities       Disability[]            @relation("DisabilityCreatedBy")
  disabilityObservations    DisabilityObservation[] @relation("DisabilityObservationCreatedBy")

  // Affiliation relations
  createdAffiliations            Affiliation[]            @relation("AffiliationCreatedBy")
  sentAffiliations               Affiliation[]            @relation("AffiliationSentBy")
  assignedSubProcesses           AffiliationSubProcess[]  @relation("SubProcessAssignedTo")
  uploadedAffiliationDocuments   AffiliationDocument[]    @relation("AffiliationDocumentUploadedBy")
  affiliationObservations        AffiliationObservation[] @relation("AffiliationObservationCreatedBy")
  affiliationStatusLogs          AffiliationStatusLog[]   @relation("StatusLogChangedBy")
  sentEmails                     SentEmail[]              @relation("SentEmailSentBy")

  // Blog relations
  blogPosts                      BlogPost[]               @relation("BlogPostAuthor")

  // Novedades relations (vacaciones, permisos, calamidades)
  novedades                      Novedad[]                @relation("UserNovedades")
  createdNovedades               Novedad[]                @relation("NovedadCreatedBy")

  // Módulo Control (caja interna)
  // Un usuario puede tener una contraparte cuando además de operar el sistema
  // recibe plata del libro (nómina complementaria, préstamos).
  contraparte                    Contraparte?             @relation("ContraparteUser")
  createdContrapartes            Contraparte[]            @relation("ContraparteCreatedBy")
  createdMovimientos             Movimiento[]             @relation("MovimientoCreatedBy")
  createdPrestamos               Prestamo[]               @relation("PrestamoCreatedBy")
  createdServiciosReferenciados  ServicioReferenciado[]   @relation("ServicioCreatedBy")
  createdCierres                 CierreMensual[]          @relation("CierreCreatedBy")
  cierresCerrados                CierreMensual[]          @relation("CierreCerradoBy")

  @@map("users")
}

// NextAuth Account model (for OAuth providers)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// OTP Rate Limiting model
model OtpRateLimit {
  id           String    @id @default(cuid())
  email        String
  attempts     Int       @default(1)
  lastAttempt  DateTime  @default(now())
  blockedUntil DateTime?

  @@map("otp_rate_limits")
  @@index([email])
}

// Client Management Enums
enum IdentificationType {
  // Personas Naturales
  CEDULA                // CC  - Cédula de Ciudadanía
  TARJETA_IDENTIDAD     // TI  - Tarjeta de Identidad
  REGISTRO_CIVIL        // RC  - Registro Civil
  CEDULA_EXTRANJERIA    // CE  - Cédula de Extranjería
  PASAPORTE             // PA  - Pasaporte
  PPT                   //      Permiso de Protección Temporal
  PEP                   //      Permiso Especial de Permanencia
  NUIP                  //      Número Único de Identificación Personal
  SALVOCONDUCTO         //      Salvoconducto
  // Personas Jurídicas
  NIT                   //      Número de Identificación Tributaria
}

enum ClientType {
  EMPLEADO
  EMPRESA
  INDEPENDIENTE
}

enum EmployeeType {
  TIEMPO_COMPLETO
  TIEMPO_PARCIAL
  INDEPENDIENTE_CONTRATISTA
}

enum WorkDaysRange {
  DIAS_1_7
  DIAS_8_14
  DIAS_15_21
  DIAS_22_30
}

enum AdministradoraType {
  EPS
  AFP
  ARL
  CCF
}

enum DocumentCategory {
  GENERAL
  ARL
  EPS
  AFP
  OTROS
}

// Client model
model Client {
  id                   String             @id @default(cuid())
  fullName             String
  identificationType   IdentificationType
  identificationNumber String             @unique
  clientType           ClientType
  employeeType         EmployeeType?
  workDaysRange        WorkDaysRange?
  email                String
  phone                String
  status               String             @default("ACTIVO")
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  createdById String
  createdBy   User               @relation("ClientCreatedBy", fields: [createdById], references: [id])
  notes       ClientNote[]
  documents   ClientDocument[]
  credentials ClientCredential[]

  // Company-Employee relationship (self-referential)
  companyId String?
  company   Client?  @relation("CompanyEmployees", fields: [companyId], references: [id], onDelete: SetNull)
  employees Client[] @relation("CompanyEmployees")

  // Disability relations (both as client and employee)
  disabilitiesAsClient   Disability[] @relation("DisabilityClient")
  disabilitiesAsEmployee Disability[] @relation("DisabilityEmployee")

  // Affiliation relations
  affiliations Affiliation[]
  subProcessesAsEmployee AffiliationSubProcess[] @relation("SubProcessEmployee")

  // Address and additional info
  address             ClientAddress?
  additionalInfo      ClientAdditionalInfo?
  beneficiaries       ClientBeneficiary[]
  legalRepresentative LegalRepresentative?

  // Administradoras (EPS, AFP, ARL, CCF)
  epsId String?
  eps   Administradora? @relation("ClientEps", fields: [epsId], references: [id])
  afpId String?
  afp   Administradora? @relation("ClientAfp", fields: [afpId], references: [id])
  arlId        String?
  arl          Administradora? @relation("ClientArl", fields: [arlId], references: [id])
  arlRiskLevel Int?            // Nivel de riesgo ARL (1-5)
  ccfId        String?
  ccf   Administradora? @relation("ClientCcf", fields: [ccfId], references: [id])

  // Employment join table back-relations (Phase 1 additive; legacy CompanyEmployees stays)
  employmentsAsEmployee Employment[] @relation("EmploymentEmployee")
  employmentsAsCompany  Employment[] @relation("EmploymentCompany")

  // Módulo Control — un cliente puede ser contraparte del libro de caja
  // (ej. A&A Moda Circular y Mompossina, clientes de mensajería).
  contraparte Contraparte? @relation("ContraparteClient")

  @@map("clients")
  @@index([companyId])
}

// Employment join table — replaces Client self-relation in Phase 3
// Coexists with legacy companyId/employeeType/workDaysRange shadow through Phase 1-2
model Employment {
  id           String        @id @default(cuid())

  // The person/entity that is employed
  employeeId   String
  employee     Client        @relation("EmploymentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  // The company that employs them
  companyId    String
  company      Client        @relation("EmploymentCompany", fields: [companyId], references: [id], onDelete: Cascade)

  // Role attributes (MOVED from Client in Phase 3; nullable for REQ-7.4 legacy tolerance)
  employeeType  EmployeeType?
  workDaysRange WorkDaysRange?

  startDate    DateTime      @default(now())
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([employeeId, companyId])
  @@index([employeeId])
  @@index([companyId])
  @@index([isActive])
  @@map("employments")
}

// Client Note model
model ClientNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById String
  createdBy User     @relation("NoteCreatedBy", fields: [createdById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_notes")
}

// Client Document model
model ClientDocument {
  id           String           @id @default(cuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  s3Key        String
  category     DocumentCategory @default(GENERAL)
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())

  @@map("client_documents")
  @@index([clientId, category])
}

// Administrator type enum
enum AdministratorType {
  EPS
  AFP
  ARL
  CCF
  PILA_OPERATOR
  OTRA
}

// Client Credential model (for managing administrator portal credentials)
model ClientCredential {
  id                String             @id @default(cuid())
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Administrator information
  administratorName String             // e.g., "Sura EPS", "Porvenir AFP"
  administratorType AdministratorType

  // Credentials (username in plain text, password encrypted with AES-256-GCM)
  username          String
  encryptedPassword String             @db.Text

  // Optional metadata
  portalUrl         String?
  notes             String?            @db.Text

  // Audit trail
  createdById       String
  createdBy         User               @relation("CredentialCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("client_credentials")
  @@index([clientId])
}

// Disability Management Enums
enum DisabilityStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CLOSED
  URGENT
}

enum HealthAdministrator {
  EPS_SURA
  PORVENIR
  NUEVA_EPS
  ARL_SURA
  SALUD_TOTAL
  SAVIA_SALUD
}

// Disability model (Incapacidades)
model Disability {
  id               String              @id @default(cuid())
  receptionDate    DateTime            // Fecha de recepción
  status           DisabilityStatus

  // Client and Employee relations
  clientId         String
  client           Client              @relation("DisabilityClient", fields: [clientId], references: [id])
  employeeId       String
  employee         Client              @relation("DisabilityEmployee", fields: [employeeId], references: [id])

  // Administrator
  administrator    HealthAdministrator

  // Dates
  startDate        DateTime            // Fecha inicio incapacidad
  endDate          DateTime            // Fecha finalización

  // Additional fields
  bankRegistry     Boolean             @default(false) // Registro banco
  transcription    String              @db.Text        // Transcripción
  filing           String              @db.Text        // Radicación

  // Proof file (comprobante)
  proofFileUrl     String?
  proofS3Key       String?

  // Soft delete
  isActive         Boolean             @default(true)

  // Timestamps
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Audit trail
  createdById      String
  createdBy        User                @relation("DisabilityCreatedBy", fields: [createdById], references: [id])

  // Relations
  observations     DisabilityObservation[]

  @@map("disabilities")
  @@index([clientId])
  @@index([employeeId])
  @@index([status])
}

// Disability Observation model
model DisabilityObservation {
  id           String     @id @default(cuid())
  content      String     @db.Text
  disabilityId String
  disability   Disability @relation(fields: [disabilityId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User       @relation("DisabilityObservationCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("disability_observations")
  @@index([disabilityId])
}

// Client Address model
model ClientAddress {
  id           String   @id @default(cuid())
  clientId     String   @unique
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Geographic information
  departamento String
  municipio    String
  ciudad       String?
  direccion    String   @db.Text

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("client_addresses")
}

// Client Additional Info model
model ClientAdditionalInfo {
  id                 String   @id @default(cuid())
  clientId           String   @unique
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Employment information
  actividadComercial String?
  salario            Decimal? @db.Decimal(12, 2)

  // Entry/exit dates
  fechaIngreso       DateTime?
  fechaRetiro        DateTime?

  // Timestamps
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("client_additional_info")
}

// Client Beneficiary model
model ClientBeneficiary {
  id                   String             @id @default(cuid())
  clientId             String
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Beneficiary information
  tipoRelacion         String             // "hijo", "padre", "conyuge", "otro"
  nombreCompleto       String
  identificationType   IdentificationType
  identificationNumber String

  // Exclusion state
  isExcluded           Boolean            @default(false)
  excludedAt           DateTime?

  // Timestamps
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  subProcessLinks      AffiliationSubProcessBeneficiary[]

  @@map("client_beneficiaries")
  @@index([clientId])
  @@unique([clientId, identificationNumber])
}

// Junction: sub-process ↔ beneficiary (used for INCLUSION/EXCLUSION_BENEFICIARIOS process types)
model AffiliationSubProcessBeneficiary {
  id              String                @id @default(cuid())
  subProcessId   String
  subProcess     AffiliationSubProcess @relation(fields: [subProcessId], references: [id], onDelete: Cascade)
  beneficiaryId  String
  beneficiary    ClientBeneficiary     @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())

  @@map("affiliation_subprocess_beneficiaries")
  @@unique([subProcessId, beneficiaryId])
  @@index([subProcessId])
  @@index([beneficiaryId])
}

// Legal Representative model (for companies)
model LegalRepresentative {
  id                   String             @id @default(cuid())
  clientId             String             @unique
  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Representative information
  fullName             String
  identificationType   IdentificationType
  identificationNumber String
  email                String?
  phone                String?

  // Timestamps
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("legal_representatives")
}

// Administradora catalog (EPS, AFP, ARL, CCF)
model Administradora {
  id       String             @id @default(cuid())
  name     String
  code     String             // Código PILA
  type     AdministradoraType
  isActive Boolean            @default(true)

  // Relations
  clientsAsEps Client[] @relation("ClientEps")
  clientsAsAfp Client[] @relation("ClientAfp")
  clientsAsArl Client[] @relation("ClientArl")
  clientsAsCcf Client[] @relation("ClientCcf")
  disabilitySubProcesses AffiliationSubProcess[] @relation("DisabilityAdministradora")

  @@unique([code, type])
  @@map("administradoras")
}

// ========================================
// AFFILIATION MODULE (Afiliaciones a Seguridad Social)
// ========================================

// Affiliation lifecycle status
enum AffiliationStatus {
  ACTIVE   // In progress (default)
  SENT     // Sent to client
  ARCHIVED // Archived (permanent)
}

// Process type for the affiliation (what kind of process it is)
enum AffiliationProcessType {
  DEPENDIENTE                      // (01) Dependiente
  INDEPENDIENTE                    // (3) Independiente
  TRABAJADOR_TIEMPO_PARCIAL        // (51) Trabajador de tiempo parcial
  INDEPENDIENTE_VOLUNTARIO         // (57) Independiente voluntario
  CONTRATISTA_INDEPENDIENTE        // (59) Contratista independiente
  BENEFICIARIO_UPC_ADICIONAL       // (40) Beneficiario UPC adicional
  COTIZANTE_INDEPENDIENTE_SALUD    // (42) Cotizante independiente pago solo salud
  COTIZANTE_PENSIONES_PAGO_TERCERO // (43) Cotizante a pensiones con pago por tercero
  PLANILLA_S_SERVICIO_DOMESTICO    // Planilla S Servicio doméstico
  PLANILLA_E_EMPLEADOS             // Planilla E (Empleados)
  LIQUIDACIONES                    // Liquidaciones
  TRASLADO_EPS                     // Traslado de EPS
  COBRO_INCAPACIDADES              // Cobro Incapacidades
  PENSIONADO                       // Pensionado
  INCLUSION_BENEFICIARIOS          // Inclusion Beneficiarios
  EXCLUSION_BENEFICIARIOS          // Exclusion de Beneficiarios
  ASESORIAS_PENSIONES              // Asesorias y pensiones
  OTRO                             // Otro (texto libre)
}

// Sub-process types
enum AffiliationSubProcessType {
  ARL              // Administradora de Riesgos Laborales
  EPS              // Entidad Promotora de Salud
  AFP              // Administradora de Fondos de Pensiones
  CCF              // Caja de Compensación Familiar
  PILA             // Pila
  TRASLADOS        // Traslados
  INCAPACIDADES    // Incapacidades
  CONCILIACION_MORA // Conciliación Mora
}

// Sub-process status states
enum AffiliationSubProcessStatus {
  NOT_STARTED       // Sin iniciar
  IN_PROGRESS       // En proceso
  PENDING_SUPPORT   // Pendiente de soporte
  PENDING_DOCUMENT  // Pendiente de documento
  IN_REVIEW         // En revisión
  COMPLETED         // Terminado
  RETURNED          // Devuelto/Rechazado
}

// Document categories for affiliation documents
enum AffiliationDocumentCategory {
  ARL_DOCS
  EPS_DOCS
  AFP_DOCS
  CCF_DOCS
  PILA_DOCS
  TRASLADOS_DOCS
  INCAPACIDADES_DOCS
  CONCILIACION_MORA_DOCS
  GENERAL
}

// Main Affiliation model
model Affiliation {
  id                String                  @id @default(cuid())
  affiliationNumber String                  @unique
  clientId          String
  client            Client                  @relation(fields: [clientId], references: [id])

  // Process type classification
  processType       AffiliationProcessType? // Tipo de proceso
  processTypeOther  String?                 // Texto libre cuando processType = OTRO

  // Status tracking
  status           AffiliationStatus       @default(ACTIVE)
  sentAt           DateTime?               // When sent to client
  sentById         String?                 // Manager who sent
  sentBy           User?                   @relation("AffiliationSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  archivedAt       DateTime?               // When archived
  startDate        DateTime?               // When the process starts

  // Audit trail
  createdById      String
  createdBy        User                    @relation("AffiliationCreatedBy", fields: [createdById], references: [id])

  // Soft delete (kept for compatibility)
  isActive         Boolean                 @default(true)

  // Free-form note for the process
  note             String?                 @db.Text

  // Timestamps
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relations
  subProcesses     AffiliationSubProcess[]
  sentEmails       SentEmail[]

  @@map("affiliations")
  @@index([status])
  @@index([clientId])
  @@index([createdById])
}

// Sub-process model (ARL, EPS, AFP, CCF)
model AffiliationSubProcess {
  id                String                        @id @default(cuid())
  affiliationId     String
  affiliation       Affiliation                   @relation(fields: [affiliationId], references: [id], onDelete: Cascade)

  // Sub-process configuration
  type              AffiliationSubProcessType
  status            AffiliationSubProcessStatus   @default(NOT_STARTED)

  // Manager assignment (nullable - can be unassigned)
  assignedToId      String?
  assignedTo        User?                         @relation("SubProcessAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Status change reason (for RETURNED status)
  statusReason      String?                       @db.Text

  // Employee assignment (for EMPRESA clients - which employee this sub-process belongs to)
  employeeId        String?
  employee          Client?                       @relation("SubProcessEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  // Disability-specific fields (only used when type = INCAPACIDADES)
  disabilityStartDate DateTime?
  disabilityEndDate   DateTime?
  bankRegistry        Boolean                     @default(false)
  transcription       Boolean                     @default(false)
  collection          Boolean                     @default(false)
  paidToUser          Boolean                     @default(false)

  // Administradora that pays/handles this disability (only one of EPS/AFP/ARL applies)
  disabilityAdministradoraId   String?
  disabilityAdministradora     Administradora?     @relation("DisabilityAdministradora", fields: [disabilityAdministradoraId], references: [id])
  disabilityAdministradoraType AdministradoraType?

  // Timestamps
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  // Relations
  documents         AffiliationDocument[]
  observations      AffiliationObservation[]
  statusLogs        AffiliationStatusLog[]
  beneficiaries     AffiliationSubProcessBeneficiary[]

  @@map("affiliation_subprocesses")
  @@index([affiliationId])
  @@index([assignedToId])
  @@index([status])
  @@index([type])
  @@index([employeeId])
}

// Document model for sub-process documents
model AffiliationDocument {
  id             String                        @id @default(cuid())
  subProcessId   String
  subProcess     AffiliationSubProcess         @relation(fields: [subProcessId], references: [id], onDelete: Cascade)

  // File metadata
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int
  s3Key          String
  category       AffiliationDocumentCategory   @default(GENERAL)

  // Display order (used when composing affiliation completion email; lower = appears first)
  displayOrder   Int                           @default(0)

  // Audit trail
  uploadedById   String
  uploadedBy     User                          @relation("AffiliationDocumentUploadedBy", fields: [uploadedById], references: [id])

  // Timestamps
  createdAt      DateTime                      @default(now())

  @@map("affiliation_documents")
  @@index([subProcessId])
  @@index([category])
}

// Observation/Note model for sub-processes
model AffiliationObservation {
  id            String                  @id @default(cuid())
  content       String                  @db.Text
  subProcessId  String
  subProcess    AffiliationSubProcess   @relation(fields: [subProcessId], references: [id], onDelete: Cascade)

  // Audit trail
  createdById   String
  createdBy     User                    @relation("AffiliationObservationCreatedBy", fields: [createdById], references: [id])

  // Timestamps
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("affiliation_observations")
  @@index([subProcessId])
}

// Status change log for audit trail
model AffiliationStatusLog {
  id                String                        @id @default(cuid())
  subProcessId      String
  subProcess        AffiliationSubProcess         @relation(fields: [subProcessId], references: [id], onDelete: Cascade)

  // Status change details
  fromStatus        AffiliationSubProcessStatus?  // Null for initial status
  toStatus          AffiliationSubProcessStatus
  reason            String?                       @db.Text

  // Audit trail
  changedById       String
  changedBy         User                          @relation("StatusLogChangedBy", fields: [changedById], references: [id])

  // Timestamp
  createdAt         DateTime                      @default(now())

  @@map("affiliation_status_logs")
  @@index([subProcessId])
  @@index([createdAt])
}

// Sent email history for affiliations
model SentEmail {
  id              String      @id @default(cuid())
  affiliationId   String
  affiliation     Affiliation @relation(fields: [affiliationId], references: [id])

  // Email fields
  toEmail         String
  ccEmails        String?     @db.Text  // JSON array of CC addresses
  subject         String
  htmlBody        String      @db.Text

  // Attachments metadata (JSON array of {fileName, fileType, fileSize})
  attachments     String?     @db.Text

  // Optional free-text notes ("novedades") included in the email body and kept for audit
  emailNotes      String?     @db.Text

  // Audit trail
  sentById        String
  sentBy          User        @relation("SentEmailSentBy", fields: [sentById], references: [id])
  sentAt          DateTime    @default(now())

  @@map("sent_emails")
  @@index([affiliationId])
}

// ========================================
// BLOG MODULE
// ========================================

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  posts     BlogPost[]

  @@map("blog_tags")
}

// ========================================
// NOVEDADES MODULE (Vacaciones, Permisos y Calamidades)
// ========================================

// Tipo de novedad
enum NovedadType {
  VACACIONES // Días de vacaciones — descuenta del banco anual de días hábiles
  PERMISO    // Permiso por horas o días — descuenta 1 día solo si supera 3 horas
  CALAMIDAD  // Calamidad doméstica — nunca descuenta vacaciones
}

// Unidad de medida de la novedad
enum NovedadUnit {
  DIAS  // Rango de días completos
  HORAS // Permiso medido en horas
}

// Modelo Novedad — un registro por solicitud (vacación / permiso / calamidad)
model Novedad {
  id        String      @id @default(cuid())
  type      NovedadType
  unit      NovedadUnit

  // Empleado al que aplica la novedad (usuario del sistema)
  userId    String
  user      User        @relation("UserNovedades", fields: [userId], references: [id])

  // Rango de fechas (ambos inclusive)
  startDate DateTime
  endDate   DateTime

  // Horas solicitadas (solo cuando unit = HORAS)
  hours     Float?

  // Días hábiles de vacaciones efectivamente descontados del banco.
  // Se calcula al guardar a partir de type/unit/hours/rango. Fuente de verdad
  // para el saldo: saldo = DÍAS_ANUALES - SUM(vacationDaysDeducted) del año.
  vacationDaysDeducted Float @default(0)

  // Año calendario del banco de vacaciones (se toma de startDate). El banco se
  // reinicia el 1 de enero — las vacaciones no se acumulan entre años.
  year      Int

  // Observación libre
  observation String? @db.Text

  // Soft delete (registros mal cargados se desactivan, no se borran)
  isActive  Boolean  @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auditoría
  createdById String
  createdBy   User   @relation("NovedadCreatedBy", fields: [createdById], references: [id])

  @@map("novedades")
  @@index([userId])
  @@index([year])
  @@index([type])
  @@index([userId, year])
}

model BlogPost {
  id                 String         @id @default(cuid())
  title              String
  slug               String         @unique
  excerpt            String?        @db.Text
  content            String         @db.Text
  status             BlogPostStatus @default(DRAFT)
  featuredImageUrl   String?
  featuredImageS3Key String?
  publishedAt        DateTime?

  // SEO fields
  metaTitle          String?
  metaDescription    String?
  keywords           String?
  ogImageUrl         String?
  ogImageS3Key       String?

  // Computed
  readingTime        Int?

  // Soft delete
  isActive           Boolean        @default(true)

  // Timestamps
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  authorId           String
  author             User           @relation("BlogPostAuthor", fields: [authorId], references: [id])
  categoryId         String?
  category           BlogCategory?  @relation(fields: [categoryId], references: [id])
  tags               BlogTag[]

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
  @@map("blog_posts")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO CONTROL — libro de caja interno
// ═══════════════════════════════════════════════════════════════════════════
//
// Reemplaza el Excel de contabilidad (hojas PAGOS POR DEBAJO, CUENTAS,
// PRESTAMOS, PAGOS FAWER, EXAMENES MEDICOS).
//
// Este libro es INDEPENDIENTE de Alegra (/dashboard/finances), que es la
// contabilidad formal y es de solo lectura. Los dos libros NUNCA se suman ni
// se consolidan; a lo sumo se referencian por id (ver alegraEstimateId).
//
// Reglas que el modelo hace cumplir:
//   1. Ningún movimiento sin bolsillo, categoría, fecha y monto > 0.
//   2. Los movimientos son INMUTABLES: no se editan ni se borran. Para
//      corregir se crea un contra-movimiento (`anulaMovimientoId`).
//   3. Los saldos NUNCA se digitan. `saldoFinalCalculado` sale de los
//      movimientos; el valor que venía del Excel entra como `saldoFinalReal`
//      solo para comparar contra el cálculo.
//   4. Los saldos de préstamo y el margen de los servicios son DERIVADOS —
//      no existen como columna, justamente para que no puedan desincronizarse.
//
// Acceso: SUPER_ADMIN o User.canAccessControl (ver lib/auth/rbac.ts).

enum TipoBolsillo {
  BANCARIA    // cuenta de banco usada como operativa (ej. IVONE)
  EFECTIVO    // caja en efectivo
  CAJA_MENOR  // caja chica para gastos menores
  AHORRO      // efectivo guardado
}

enum TipoContraparte {
  EMPLEADO   // equipo interno; puede o no tener usuario del sistema
  PROVEEDOR  // a quien se le paga (Fawer, laboratorio, don Luis)
  CLIENTE    // quien paga (A&A Moda Circular, Mompossina, pacientes)
  OTRO
}

enum TipoMovimiento {
  INGRESO
  EGRESO
  TRASLADO  // entre dos bolsillos; exige bolsilloDestinoId
}

// Agrupación para reportes. La categoría concreta vive en un catálogo
// editable (CategoriaMovimiento) para no necesitar migración cada vez que
// aparece un concepto nuevo.
enum GrupoCategoria {
  NOMINA_COMPLEMENTARIA  // los pagos "por debajo"
  NOMINA_FIJA            // recurrentes mensuales del equipo
  COMISION
  SERVICIO_REFERENCIADO  // patas de un ServicioReferenciado
  GASTO_OPERATIVO        // papelería, transporte, arreglos de oficina
  GASTO_BIENESTAR        // almuerzos, regalos, celebraciones
  PRESTAMO_DESEMBOLSO
  PRESTAMO_ABONO
  TRASLADO
  DEVOLUCION
  OTRO
}

// Bolsillo: de dónde sale y a dónde entra la plata.
// El catálogo es editable — el Excel muestra IVONE, EFECTIVO, CAJA MENOR,
// ADMON, AHORRO EFECTIVO y JOSE Q (cerrado en enero-2026), pero hay más
// cuentas en uso.
model Bolsillo {
  id        String       @id @default(cuid())
  nombre    String       @unique
  tipo      TipoBolsillo
  orden     Int          @default(0) // orden de despliegue en la UI

  // Un bolsillo que se deja de usar se cierra, no se borra: sus movimientos
  // históricos tienen que seguir existiendo.
  isActive  Boolean      @default(true)
  cerradoEn DateTime?    @db.Date

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  movimientos       Movimiento[]    @relation("MovimientoBolsillo")
  movimientosComoDestino Movimiento[] @relation("MovimientoBolsilloDestino")
  prestamosOriginados    Prestamo[]  @relation("PrestamoBolsilloOrigen")
  cierres           CierreMensual[]

  @@map("bolsillos")
  @@index([isActive, orden])
}

// Contraparte: quién recibe o entrega plata en este libro.
//
// Un solo catálogo para empleados, proveedores, clientes y pacientes, con
// enlaces OPCIONALES a User y Client. Se hizo así a propósito: con entidades
// separadas (persona / tercero), cada Movimiento cargaría dos FK nullables y
// nada garantizaría que exactamente una esté llena.
//
// NO se extiende User: `email` es único y hay `password`, así que un
// proveedor informal exigiría un email falso y quedaría como fila capaz de
// iniciar sesión. Además Novedad ya trata a User como empleado interno.
model Contraparte {
  id        String          @id @default(cuid())
  nombre    String
  tipo      TipoContraparte

  // Si es del equipo y tiene usuario del sistema
  userId    String?         @unique
  user      User?           @relation("ContraparteUser", fields: [userId], references: [id], onDelete: SetNull)

  // Si es un cliente ya registrado en el sistema
  clientId  String?         @unique
  client    Client?         @relation("ContraparteClient", fields: [clientId], references: [id], onDelete: SetNull)

  // Solo dígitos, sin dígito de verificación (el DV se calcula con el
  // algoritmo DIAN). Ej: NIT 901485874-1 se guarda como "901485874".
  documento String?         @unique

  notas     String?         @db.Text
  isActive  Boolean         @default(true)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String
  createdBy   User          @relation("ContraparteCreatedBy", fields: [createdById], references: [id])

  movimientos          Movimiento[]
  prestamos            Prestamo[]
  serviciosComoCliente   ServicioReferenciado[] @relation("ServicioCliente")
  serviciosComoProveedor ServicioReferenciado[] @relation("ServicioProveedor")

  @@map("contrapartes")
  @@index([tipo, isActive])
  @@index([nombre])
}

// Catálogo editable de categorías. `grupo` es lo que se usa para reportes.
model CategoriaMovimiento {
  id        String         @id @default(cuid())
  nombre    String         @unique
  grupo     GrupoCategoria
  isActive  Boolean        @default(true)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  movimientos Movimiento[]

  @@map("categorias_movimiento")
  @@index([grupo, isActive])
}

// Catálogo de tipos de servicio referenciado (mensajería, exámenes médicos…).
// Es tabla y no enum a propósito: van a aparecer más servicios y no debería
// hacer falta una migración para agregarlos.
model TipoServicioReferenciado {
  id       String  @id @default(cuid())
  nombre   String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicios ServicioReferenciado[]

  @@map("tipos_servicio_referenciado")
}

// ───────────────────────────────────────────────────────────────────────────
// Movimiento — la tabla central. Las cuatro hojas de dinero del Excel
// colapsan acá; todo lo demás es una vista sobre esto.
// ───────────────────────────────────────────────────────────────────────────
//
// INMUTABLE. No hay updatedAt ni isActive porque no se edita ni se borra: un
// movimiento equivocado se corrige creando otro que lo anula. Esto es lo que
// evita el error silencioso del Excel, donde alguien pisó un saldo y el
// descuadre desapareció de la vista.
model Movimiento {
  id       String         @id @default(cuid())

  // Fecha de calendario, no timestamp: todo el libro es America/Bogotá y un
  // pago no debe poder correrse de día por zona horaria.
  fecha    DateTime       @db.Date
  // "2026-08" — denormalizado para agrupar y cerrar por periodo.
  periodo  String
  tipo     TipoMovimiento
  monto    Decimal        @db.Decimal(14, 2)
  concepto String

  // De dónde salió / a dónde entró. Obligatorio, siempre.
  bolsilloId String
  bolsillo   Bolsillo @relation("MovimientoBolsillo", fields: [bolsilloId], references: [id])

  // Solo para TRASLADO. Hay un CHECK en la migración que lo exige para
  // TRASLADO, lo prohíbe para el resto, e impide que sea igual al origen.
  bolsilloDestinoId String?
  bolsilloDestino   Bolsillo? @relation("MovimientoBolsilloDestino", fields: [bolsilloDestinoId], references: [id])

  categoriaId String
  categoria   CategoriaMovimiento @relation(fields: [categoriaId], references: [id])

  contraparteId String?
  contraparte   Contraparte? @relation(fields: [contraparteId], references: [id])

  // Si es desembolso o abono de un préstamo
  prestamoId String?
  prestamo   Prestamo? @relation(fields: [prestamoId], references: [id])

  // Anulación: este movimiento revierte a otro. Único, para que un
  // movimiento no pueda anularse dos veces.
  anulaMovimientoId String?     @unique
  anulaMovimiento   Movimiento? @relation("MovimientoAnulacion", fields: [anulaMovimientoId], references: [id])
  anuladoPor        Movimiento? @relation("MovimientoAnulacion")

  notas        String? @db.Text
  // Trazabilidad de la migración: "PAGOS POR DEBAJO!K168"
  origenImport String?

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("MovimientoCreatedBy", fields: [createdById], references: [id])

  servicioComoIngreso ServicioReferenciado? @relation("ServicioMovimientoIngreso")
  servicioComoEgreso  ServicioReferenciado? @relation("ServicioMovimientoEgreso")

  @@map("movimientos")
  @@index([periodo, bolsilloId])
  @@index([fecha])
  @@index([contraparteId, fecha])
  @@index([categoriaId])
  @@index([prestamoId])
}

// ───────────────────────────────────────────────────────────────────────────
// Préstamo — desembolso a una contraparte, con abonos.
// ───────────────────────────────────────────────────────────────────────────
//
// `saldoActual` y `estado` NO son columnas: se derivan de los movimientos
// ligados por prestamoId. Guardarlos sería repetir el error del Excel, donde
// el estado es texto libre con 178 variantes ("DESCONTADO 30/04", "ok",
// "RESTA 100,000") y no hay forma de saber cuánto debe alguien sin leer 240
// filas.
//
// La única parte del estado que no se puede derivar es la decisión de dar un
// préstamo por perdido, y por eso es un flag explícito.
model Prestamo {
  id              String   @id @default(cuid())
  contraparteId   String
  contraparte     Contraparte @relation(fields: [contraparteId], references: [id])

  fechaDesembolso DateTime @db.Date
  montoOriginal   Decimal  @db.Decimal(14, 2)
  concepto        String

  bolsilloOrigenId String
  bolsilloOrigen   Bolsillo @relation("PrestamoBolsilloOrigen", fields: [bolsilloOrigenId], references: [id])

  // Decisión manual, no derivable. Un préstamo activo NO se archiva: si
  // desaparece de la vista vuelve el problema que teníamos en el Excel.
  marcadoIncobrable Boolean @default(false)
  incobrableMotivo  String? @db.Text

  notas        String? @db.Text
  origenImport String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("PrestamoCreatedBy", fields: [createdById], references: [id])

  // Desembolso + abonos
  movimientos Movimiento[]

  @@map("prestamos")
  @@index([contraparteId])
  @@index([fechaDesembolso])
}

// ───────────────────────────────────────────────────────────────────────────
// ServicioReferenciado — servicio que Admon intermedia entre un cliente y un
// tercero, atando las dos patas de movimiento.
// ───────────────────────────────────────────────────────────────────────────
//
// Mensajería y exámenes médicos son el mismo animal:
//
//   mensajería  cotiza 520.000 → entrega 520.000 a Fawer        → margen 0
//   exámenes    cobra   45.000 → entrega  30.000 al consultorio → margen 15.000
//
// Registrar solo el egreso — que es lo que hace el Excel hoy — infla el gasto
// del mes con plata que no es de Admon, y es un error que nunca se detecta
// porque se ve como un gasto más.
//
// `margen` NO es columna: es valorFacturado - valorEntregado. En junio-2026 la
// comisión de exámenes fue 10.000 en dos casos y 15.000 en otros dos, así que
// tampoco puede ser una constante de configuración.
model ServicioReferenciado {
  id             String @id @default(cuid())

  tipoServicioId String
  tipoServicio   TipoServicioReferenciado @relation(fields: [tipoServicioId], references: [id])

  fecha   DateTime @db.Date
  periodo String

  // Quién paga
  clienteId String
  cliente   Contraparte @relation("ServicioCliente", fields: [clienteId], references: [id])
  // A quién se le entrega (Fawer, el consultorio)
  proveedorId String
  proveedor   Contraparte @relation("ServicioProveedor", fields: [proveedorId], references: [id])

  valorFacturado Decimal @db.Decimal(14, 2)
  valorEntregado Decimal @db.Decimal(14, 2)

  // null = facturado/cotizado pero todavía sin cobrar
  movimientoIngresoId String?     @unique
  movimientoIngreso   Movimiento? @relation("ServicioMovimientoIngreso", fields: [movimientoIngresoId], references: [id])
  // null = cobrado pero todavía sin entregar al tercero
  movimientoEgresoId  String?     @unique
  movimientoEgreso    Movimiento? @relation("ServicioMovimientoEgreso", fields: [movimientoEgresoId], references: [id])

  // Referencia a la cotización en Alegra. Es un puntero para poder saltar a
  // /dashboard/finances/estimates/[id], NO una consolidación de los dos libros.
  alegraEstimateId String?

  notas        String? @db.Text
  origenImport String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("ServicioCreatedBy", fields: [createdById], references: [id])

  @@map("servicios_referenciados")
  @@index([periodo])
  @@index([tipoServicioId, fecha])
  @@index([clienteId])
  @@index([proveedorId])
}

// ───────────────────────────────────────────────────────────────────────────
// CierreMensual — saldo por bolsillo y periodo. Reemplaza la hoja CUENTAS.
// ───────────────────────────────────────────────────────────────────────────
//
// `saldoFinalCalculado` NUNCA se digita: sale de saldoInicial + movimientos
// del periodo. `saldoFinalReal` es el conteo físico o el extracto, y existe
// para COMPARAR contra el cálculo — no para reemplazarlo.
//
// Cuando difieren, la diferencia queda registrada y exige justificación. En el
// Excel esto no se validaba: ADMON cerró noviembre-2025 en 8.000.000 y abrió
// diciembre en 6.067.340, y esos 1.932.660 no dejaron rastro.
model CierreMensual {
  id         String @id @default(cuid())
  periodo    String // "2026-08"
  bolsilloId String
  bolsillo   Bolsillo @relation(fields: [bolsilloId], references: [id])

  // Debe ser igual al saldo final del periodo anterior. La única excepción es
  // el arranque del módulo, marcado con esAperturaInicial.
  saldoInicial        Decimal  @db.Decimal(14, 2)
  saldoFinalCalculado Decimal  @db.Decimal(14, 2)
  saldoFinalReal      Decimal? @db.Decimal(14, 2)
  diferencia          Decimal? @db.Decimal(14, 2)
  justificacion       String?  @db.Text

  // Saldo semilla al arrancar el módulo: es el único que se digita.
  esAperturaInicial Boolean @default(false)

  // Un periodo cerrado no admite movimientos nuevos sin reabrirlo.
  cerrado     Boolean   @default(false)
  cerradoEn   DateTime?
  cerradoById String?
  cerradoBy   User?     @relation("CierreCerradoBy", fields: [cerradoById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("CierreCreatedBy", fields: [createdById], references: [id])

  @@unique([periodo, bolsilloId])
  @@map("cierres_mensuales")
  @@index([periodo])
  @@index([bolsilloId, periodo])
}
